# CardMax Customer Frontend Environment Variables
PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_SWAGGER_URL="http://localhost:3000/api/swagger"
NEXT_PUBLIC_API_DOCS_URL="http://localhost:3000/api/docs"

# Provider switch (browser / firebase)
NEXT_PUBLIC_NOTIFICATION_PROVIDER=browser

# Firebase client SDK config
NEXT_PUBLIC_FIREBASE_API_KEY=test-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=test-auth-domain
NEXT_PUBLIC_FIREBASE_PROJECT_ID=test-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=test-storage-bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=test-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=test-app-id
NEXT_PUBLIC_FIREBASE_VAPID_KEY=test-vapid-key
